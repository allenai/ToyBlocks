(define (domain blocks-tamp)
  (:requirements :strips :typing :adl :conditional-effects :quantified-preconditions)
  (:types 
    block_r_e block_o_b block_t_g - block
    block_letter block_digit - block
    block_red block_blue block_green block_yellow block_purple block_orange block_brown block_gray block_black block_white - block
    block_cyan block_pink block_teal - block
    table  
    gripper
    conf
    pose
    traj
    dir
    rot_dir flip_dir - dir 
    align 
    ori
    face
  )

  (:predicates
    (holding ?g - gripper ?b - block)
    (clear ?b - block)
    (handempty ?g - gripper)
    (on_table ?b - block ?t - table)
    (on ?b1 - block ?b2 - block)
    (on_right ?b1 - block ?b2 - block)
    (ori_of ?b - block ?o - ori)
    (on_table_side ?b - block ?t - table)
    (place_obstructs ?b1 - block ?b2 - block)
    (up_face ?o - ori ?u - face)
    (front_face ?o - ori ?f - face)
    (top_align ?o - ori ?a - align)
    (yaw_next ?d - rot_dir ?o - ori ?o2 - ori)
    (flip_next ?d - flip_dir ?o - ori ?o2 - ori)
    (ori_pnp_reachable ?o - ori ?o2 - ori) ; ori_pnp_reachable ?o1 ?o2 means o2 is reachable from o1 with pnp
    (pick_obstructs ?b1 - block ?b2 - block)
    (reorient_obstructs ?b1 - block ?b2 - block ?d - flip_dir)
    (rotate_obstructs ?b1 - block ?b2 - block ?d - rot_dir)
    (initialized)
    (on_front ?b1 - block ?b2 - block)
    (on_back ?b1 - block ?b2 - block)
    (on_left ?b1 - block ?b2 - block)
    (next_to ?b1 - block ?b2 - block)
    (cant_flip ?b - block ?d - flip_dir)
    (cant_rotate ?b - block)
    (push_obstructs ?b1 - block ?b2 - block)
    (gripper_at_init)
    (at ?g - gripper ?b - block)
  )

  (:constants 
      o1 o2 o3 o4 o5 o6 o7 o8 o9 o10 o11 o12 o13 o14 o15 o16 o17 o18 o19 o20 o21 o22 o23 o24 - ori
      forward backward left_flip right_flip - flip_dir
      cw ccw - rot_dir
      front back left right - align
      one two three four five six - face
  )

