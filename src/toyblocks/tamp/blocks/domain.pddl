  (:action pnp_table_table
    :parameters (?g - gripper ?b1 - block ?t - table ?o - ori ?o2 - ori)
    :precondition (and 
      (initialized)
      (at ?g ?b1)
      (handempty ?g)
      (clear ?b1)
      (on_table ?b1 ?t)
      (forall (?b2 - block) (not (pick_obstructs ?b2 ?b1)))
      (forall (?b2 - block) (not (place_obstructs ?b2 ?b1)))
      (ori_of ?b1 ?o)
      (ori_pnp_reachable ?o ?o2)
      ; can't pick up a block that has been pushed adjacent to another block
      (forall (?ba - block) (not (on_right ?b1 ?ba)))
      (forall (?ba - block) (not (on_left ?b1 ?ba)))
      (forall (?ba - block) (not (next_to ?b1 ?ba)))
      (forall (?ba - block) (not (on_front ?b1 ?ba)))
      (forall (?ba - block) (not (on_back ?b1 ?ba)))
    )
    :effect(and 
      (clear ?b1)
      ;(forall (?b7 - block) (not (pick_obstructs ?b1 ?b7)))
      ;(forall (?b8 - block ?d1 - flip_dir) (not (reorient_obstructs ?b1 ?b8 ?d1)))
      (forall (?b5 - block ?d1 - flip_dir) (not (reorient_obstructs ?b5 ?b1 ?d1)))
      ;(forall (?b4 - block ?d2 - rot_dir) (not (rotate_obstructs ?b1 ?b4 ?d2)))
      (forall (?b6 - block ?d2 - rot_dir) (not (rotate_obstructs ?b6 ?b1 ?d2)))
      (forall (?d2 - flip_dir) (not (cant_flip ?b1 ?d2)))
      (not (cant_rotate ?b1))
      (not (ori_of ?b1 ?o))
      (ori_of ?b1 ?o2)
    )
  )

  (:action pnp_block_table
    :parameters (?g - gripper ?b1 - block ?b2 - block ?t - table ?o - ori ?o2 - ori)
    :precondition (and 
      (initialized)
      (at ?g ?b1)
      (on ?b1 ?b2)
      (handempty ?g)
      (clear ?b1)
      (forall (?b3 - block) (not (pick_obstructs ?b3 ?b1)))
      (forall (?b3 - block) (not (place_obstructs ?b3 ?b1)))
      (ori_of ?b1 ?o)
      (ori_pnp_reachable ?o ?o2)
    )
    :effect(and 
      (on_table ?b1 ?t)
      (handempty ?g)
      (clear ?b1)
      (not (handempty ?g))
      (clear ?b2)
      (not (on ?b1 ?b2))
      ;(forall (?b7 - block) (not (pick_obstructs ?b1 ?b7)))
      ;(forall (?b8 - block ?d1 - flip_dir) (not (reorient_obstructs ?b1 ?b8 ?d1)))
      (forall (?b5 - block ?d1 - flip_dir) (not (reorient_obstructs ?b5 ?b1 ?d1)))
      ;(forall (?b4 - block ?d2 - rot_dir) (not (rotate_obstructs ?b1 ?b4 ?d2)))
      (forall (?b6 - block ?d2 - rot_dir) (not (rotate_obstructs ?b6 ?b1 ?d2)))
      (forall (?d2 - flip_dir) (not (cant_flip ?b1 ?d2))) 
      (not (ori_of ?b1 ?o))
      (ori_of ?b1 ?o2)
    )
  )

  (:action move_to_side
    :parameters (?g - gripper ?b - block ?t - table)
    :precondition (and 
      (initialized)
      (at ?g ?b)
      (handempty ?g)
      (clear ?b)
      (on_table ?b ?t)
      (forall (?b2 - block) (not (pick_obstructs ?b2 ?b)))
      (forall (?b2 - block) (not (place_obstructs ?b2 ?b)))
      ; can't pick up a block that has been pushed adjacent to another block
      (forall (?ba - block) (not (on_right ?b ?ba)))
      (forall (?ba - block) (not (on_left ?b ?ba)))
      (forall (?ba - block) (not (next_to ?b ?ba)))
      (forall (?ba - block) (not (on_front ?b ?ba)))
      (forall (?ba - block) (not (on_back ?b ?ba)))
    )
    :effect (and
      ;(not (on_table ?b ?t))
      (on_table_side ?b ?t)
      (forall (?b3 - block) (not (pick_obstructs ?b ?b3)))
      (forall (?b3 - block ?d - flip_dir) (not (reorient_obstructs ?b ?b3 ?d)))
      (forall (?b3 - block ?d - rot_dir) (not (rotate_obstructs ?b ?b3 ?d)))
      (forall (?b3 - block) (not (place_obstructs ?b ?b3)))
    )
  )

  (:action move_to 
    :parameters (?g - gripper ?b1 - block ?b2 - block)
    :precondition (and 
      (initialized)
      (or (at ?g ?b1) (gripper_at_init))
    ) 
    :effect(and 
      (not (gripper_at_init))
      (not (at ?g ?b1))
      (at ?g ?b2)
    )
  )

  (:action move_to_center
    :parameters (?g - gripper ?b - block ?t - table)
    :precondition (and
      (initialized)
      (handempty ?g)
      (at ?g ?b)
      (clear ?b)
      (on_table_side ?b ?t)
      (forall (?b2 - block) (not (pick_obstructs ?b2 ?b)))
      (forall (?b2 - block) (not (place_obstructs ?b2 ?b)))
      ; can't pick up a block that has been pushed adjacent to another block
      (forall (?ba - block) (not (on_right ?b ?ba)))
      (forall (?ba - block) (not (on_left ?b ?ba)))
      (forall (?ba - block) (not (next_to ?b ?ba)))
      (forall (?ba - block) (not (on_front ?b ?ba)))
      (forall (?ba - block) (not (on_back ?b ?ba)))
    )
    :effect (and 
      (not (on_table_side ?b ?t))
      ;(on_table ?b ?t)
      (forall (?d - flip_dir) (not (cant_flip ?b ?d)))
      (not (cant_rotate ?b))
    )
  )

  (:action pnp_table_block
    :parameters (?g - gripper ?b1 - block ?b2 - block ?t - table ?o - ori ?o2 - ori)
    :precondition (and 
      (initialized)
      (handempty ?g)
      (at ?g ?b1)
      (clear ?b1)
      (on_table ?b1 ?t)
      (clear ?b2)
      (not (= ?b1 ?b2))
      (forall (?b3 - block) (not (pick_obstructs ?b3 ?b1)))
      (forall (?b3 - block) (not (place_obstructs ?b3 ?b1)))
      (ori_of ?b1 ?o)
      (ori_pnp_reachable ?o ?o2)
      ; can't pick up a block that has been pushed adjacent to another block
      (forall (?ba - block) (not (on_right ?b1 ?ba)))
      (forall (?ba - block) (not (on_left ?b1 ?ba)))
      (forall (?ba - block) (not (next_to ?b1 ?ba)))
      (forall (?ba - block) (not (on_front ?b1 ?ba)))
      (forall (?ba - block) (not (on_back ?b1 ?ba)))
    )
    :effect (and 
      (not (on_table ?b1 ?t))
      (on ?b1 ?b2)
      (not (clear ?b2))
      ;(forall (?b7 - block) (not (pick_obstructs ?b1 ?b7)))
      ;(forall (?b8 - block ?d1 - flip_dir) (not (reorient_obstructs ?b1 ?b8 ?d1)))
      (forall (?b5 - block ?d1 - flip_dir) (not (reorient_obstructs ?b5 ?b1 ?d1)))
      ;(forall (?b4 - block ?d2 - rot_dir) (not (rotate_obstructs ?b1 ?b4 ?d2)))
      (forall (?b6 - block ?d2 - rot_dir) (not (rotate_obstructs ?b6 ?b1 ?d2)))
      (forall (?d2 - flip_dir) (not (cant_flip ?b1 ?d2)))
      (not (ori_of ?b1 ?o))
      (ori_of ?b1 ?o2)
    )
  )

  (:action pnp_block_block
    :parameters (?g - gripper ?b1 - block ?b2 - block ?b3 - block ?o - ori ?o2 - ori)
    :precondition (and 
      (initialized)
      (at ?g ?b1)
      (on ?b1 ?b2)
      (handempty ?g)
      (clear ?b1)
      (clear ?b3)
      (forall (?b4 - block) (not (pick_obstructs ?b4 ?b1)))
      (not (= ?b1 ?b2))
      (not (= ?b1 ?b3))
      (ori_of ?b1 ?o)
      (ori_pnp_reachable ?o ?o2)
    )

    :effect (and 
      (not (on ?b1 ?b2))
      (clear ?b2)
      (on ?b1 ?b3)
      (not (clear ?b3))
      (forall (?b4 - block) (not (pick_obstructs ?b1 ?b4)))
      (forall (?b4 - block ?d1 - flip_dir) (not (reorient_obstructs ?b1 ?b4 ?d1)))
      (forall (?b4 - block ?d2 - rot_dir) (not (rotate_obstructs ?b1 ?b4 ?d2)))
      (forall (?d2 - flip_dir) (not (cant_flip ?b1 ?d2)))
      (not (ori_of ?b1 ?o))
      (ori_of ?b1 ?o2)
    )
  )


  (:action push_to_right
    :parameters (?g - gripper ?b1 - block ?b2 - block ?t - table)
    :precondition (and 
      (initialized)
      (on_table ?b1 ?t)
      (on_table ?b2 ?t)
      (at ?g ?b1)
      (handempty ?g)
      (clear ?b1)
    )
    :effect (and 
        (on_right ?b1 ?b2)
    )
  )

  (:action push_next_to
    :parameters (?g - gripper ?b1 - block ?b2 - block ?t - table)
    :precondition (and 
      (initialized)
      (on_table ?b1 ?t)
      (on_table ?b2 ?t)
      (at ?g ?b1)
      (handempty ?g)
      (clear ?b1)
    )
    :effect (and 
      (next_to ?b1 ?b2)
    )
  )

