  (:action rotate
    :parameters (?g - gripper ?b - block ?d - rot_dir ?o - ori ?o2 - ori ?table - table)
    :precondition (and 
      (initialized)
      (at ?g ?b)
      (handempty ?g)
      (on_table ?b ?table)
      (clear ?b)
      (ori_of ?b ?o)
      (yaw_next ?d ?o ?o2)
      (not (cant_rotate ?b))
      (not (on_table_side ?b ?table))
      (forall (?b2 - block) (not (rotate_obstructs ?b2 ?b ?d)))
      ; can't rotate a block that has been pushed adjacent to another block
      (forall (?ba - block) (not (on_right ?b ?ba)))
      (forall (?ba - block) (not (on_left ?b ?ba)))
      (forall (?ba - block) (not (next_to ?b ?ba)))
      (forall (?ba - block) (not (on_front ?b ?ba)))
      (forall (?ba - block) (not (on_back ?b ?ba)))
      ; can't rotate a block that has another block pushed adjacent to it
      (forall (?ba - block) (not (on_right ?ba ?b)))
      (forall (?ba - block) (not (on_left ?ba ?b)))
      (forall (?ba - block) (not (next_to ?ba ?b)))
      (forall (?ba - block) (not (on_front ?ba ?b)))
      (forall (?ba - block) (not (on_back ?ba ?b)))
    )
    :effect (and 
      (not (ori_of ?b ?o)) 
      (ori_of ?b ?o2)
    )
  )

  (:action reorient
    :parameters (?g - gripper ?b - block ?d - flip_dir ?o - ori ?o2 - ori ?table - table)
    :precondition (and
      (initialized)
      (handempty ?g)
      (at ?g ?b)
      (on_table ?b ?table)
      (not (on_table_side ?b ?table))
      (ori_of ?b ?o)
      (flip_next ?d ?o ?o2)
      (clear ?b)
      (forall (?b2 - block) (not (reorient_obstructs ?b2 ?b ?d)))
      (not (cant_flip ?b ?d))
      ; can't reorient/flip a block that has been pushed adjacent to another block
      (forall (?ba - block) (not (on_right ?b ?ba)))
      (forall (?ba - block) (not (on_left ?b ?ba)))
      (forall (?ba - block) (not (next_to ?b ?ba)))
      (forall (?ba - block) (not (on_front ?b ?ba)))
      (forall (?ba - block) (not (on_back ?b ?ba)))
      ; can't reorient/flip a block that has another block pushed adjacent to it
      (forall (?ba - block) (not (on_right ?ba ?b)))
      (forall (?ba - block) (not (on_left ?ba ?b)))
      (forall (?ba - block) (not (next_to ?ba ?b)))
      (forall (?ba - block) (not (on_front ?ba ?b)))
      (forall (?ba - block) (not (on_back ?ba ?b)))
    )
    :effect (and
      (not (ori_of ?b ?o))
      (ori_of ?b ?o2)
    )
  )
)
